# Copy this file to .env and adjust. Every value is optional; defaults are shown.

# REQUIRED in production: a long random string, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-before-deploying-taskmaster-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# SQLite database file (created automatically on first start)
DATABASE_URL=sqlite:///./taskmaster.db

# Attachments are saved in this folder
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# JSON list of allowed browser origins
CORS_ORIGINS=["*"]

# Optional: enables AI-written task descriptions and summaries with Claude.
# Leave empty to use the built-in template instead.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
